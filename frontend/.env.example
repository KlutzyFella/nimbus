# Copy to .env.local and fill in. Every variable below is required to run
# the frontend; the build works without them, but pages will not load.
#
# Get the Clerk keys from https://dashboard.clerk.com/last-active?path=api-keys
# (free Clerk application). The publishable key is public by design.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Where the dashboard POSTs uploads: the V1 API Gateway URL, or the V2
# ingress address, e.g. http://<EC2_PUBLIC_IP>/upload
NEXT_PUBLIC_UPLOAD_ENDPOINT=
